#!/usr/bin/env node
'use strict';
/* Start the hub.
 *   control-room            serve with the config at $CONTROL_ROOM_CONFIG or ~/.config/control-room/config.json (none: the setup wizard)
 *   control-room --demo     a made-up fleet in a throwaway data dir (for trying the UI and for screenshots)
 *   control-room --port N   override the port */
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const fsReal = fs.realpathSync(__filename);
const ROOT = path.join(path.dirname(fsReal), '..');
const CONFIG = require(path.join(ROOT, 'src', 'config'));
const { createHub } = require(path.join(ROOT, 'src', 'hub'));
const { makeServer } = require(path.join(ROOT, 'src', 'http', 'server'));

const args = process.argv.slice(2);
if (args.includes('-h') || args.includes('--help')) {
  console.log('usage: control-room [--demo] [--port N]\n  config: $CONTROL_ROOM_CONFIG or ~/.config/control-room/config.json (see control-room.config.example.json)');
  process.exit(0);
}
const env = { ...process.env };
if (args.includes('--demo')) {
  env.CONTROL_ROOM_DEMO = '1';
  if (!env.CONTROL_ROOM_DATA) env.CONTROL_ROOM_DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'control-room-demo-'));
  if (!env.CONTROL_ROOM_CONFIG) env.CONTROL_ROOM_CONFIG = path.join(env.CONTROL_ROOM_DATA, 'config.json');   // never the real config
}
const pi = args.indexOf('--port'); if (pi >= 0) env.CONTROL_ROOM_PORT = args[pi + 1];

const cfg = CONFIG.load(env);
const hub = createHub(cfg);
if (hub.demo && hub.setupNeeded()) {
  const pw = env.CONTROL_ROOM_DEMO_PASSWORD || crypto.randomBytes(9).toString('base64url');
  hub.createAdmin('Demo admin', pw, { demo: true });
  console.log(`demo admin password: ${pw}`);
}
hub.ensureCore('owner');
hub.syncDesks();
const server = makeServer(hub);
server.listen(cfg.port, cfg.bind, () => {
  const url = `http://${cfg.bind === '0.0.0.0' ? 'localhost' : cfg.bind}:${cfg.port}`;
  console.log(`control-room ${hub.demo ? '(demo) ' : ''}on ${url}${cfg.publicUrl ? ' (public: ' + cfg.publicUrl + ')' : ''}`);
  console.log(`data: ${cfg.dataDir}${cfg.exists ? '' : '  (no config file yet: ' + cfg.file + ')'}`);
  if (hub.setupNeeded()) console.log(`first run: open ${url}/setup`);
  if (!hub.demo && !hub.tmux.available()) console.log('warning: tmux not found; agents cannot be started until it is installed');
  hub.startLoops();
});
const bye = () => { hub.stopLoops(); server.close(); process.exit(0); };
process.on('SIGINT', bye); process.on('SIGTERM', bye);
